[Unit]
Description=Terra owner-only Bluetooth actuator peripheral
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
User=terra-rover
Group=terra-rover
SupplementaryGroups=i2c bluetooth
StateDirectory=terra-rover
StateDirectoryMode=0700
WorkingDirectory=/var/lib/terra-rover
EnvironmentFile=/etc/terra-rover/rover.env
ExecStart=/usr/local/bin/terra-rover --button-pairing --config /var/lib/terra-rover/layout.json --owner /var/lib/terra-rover/owner.json --gate-file ${TERRA_GATE_FILE} --pwm-ports ${TERRA_PWM_PORTS}
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/terra-rover
# The Fusion HAT vendor driver exposes actuator controls through sysfs.
ReadWritePaths=-/sys/class/fusion_hat
UMask=0077

[Install]
WantedBy=multi-user.target
