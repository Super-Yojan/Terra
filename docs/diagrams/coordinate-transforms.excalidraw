  {
   "id": "t50",
   "type": "text",
   "x": 1320,
   "y": 172,
   "width": 249.6,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "f34",
   "roundness": null,
   "seed": 41125322,
   "version": 1,
   "versionNonce": 1412852770,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "         col 1      col 2\n        (x\u0302_B)      (\u0177_B)\nR(\u03b8) = [ cos\u03b8      \u2212sin\u03b8 ]\n       [ sin\u03b8       cos\u03b8 ]",
   "originalText": "         col 1      col 2\n        (x\u0302_B)      (\u0177_B)\nR(\u03b8) = [ cos\u03b8      \u2212sin\u03b8 ]\n       [ sin\u03b8       cos\u03b8 ]",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b0n"
  },
  {
   "id": "t51",
   "type": "text",
