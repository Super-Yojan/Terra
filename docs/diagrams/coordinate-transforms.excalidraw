   "roundness": null,
   "seed": 1211017057,
   "version": 1,
   "versionNonce": 1583921099,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "v^W  =  R_{W\u2190A}  \u00b7  R_{A\u2190C}  \u00b7  R_{C\u2190B}  \u00b7  v^B",
   "originalText": "v^W  =  R_{W\u2190A}  \u00b7  R_{A\u2190C}  \u00b7  R_{C\u2190B}  \u00b7  v^B",
