   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The Subscript Cancellation Rule (apply right-to-left to a vector v^B):",
   "originalText": "The Subscript Cancellation Rule (apply right-to-left to a vector v^B):",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b1F"
  },
  {
   "id": "t79",
   "type": "text",
   "x": 50,
   "y": 1032,
   "width": 507.59999999999997,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
