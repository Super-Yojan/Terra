   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Step 1: rotate p^B to align\n        with world axes  \u2192 R(\u03b8)\u00b7p^B\nStep 2: shift by rover\n        position t       \u2192 + t",
   "originalText": "Step 1: rotate p^B to align\n        with world axes  \u2192 R(\u03b8)\u00b7p^B\nStep 2: shift by rover\n        position t       \u2192 + t",
