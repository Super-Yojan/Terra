   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Multiply R \u00b7 p^B:",
   "originalText": "Multiply R \u00b7 p^B:",
   "fontSize": 15,
