   "versionNonce": 395962153,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "             W \u2190 A      A \u2190 C      C \u2190 B     (B)      \u21d2  A cancels, C cancels, B cancels \u2192 leaves W!",
