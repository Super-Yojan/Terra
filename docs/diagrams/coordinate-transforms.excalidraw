   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Geometric meaning of R \u00b7 p^B",
   "originalText": "Geometric meaning of R \u00b7 p^B",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
