   "index": "b0t"
  },
  {
   "id": "t57",
   "type": "text",
   "x": 1313,
   "y": 458,
   "width": 271.15000000000003,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
