   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "          arkX  arkY  arkZ\nR_{W\u2190A} = [  0     0    -1 ]  x_W = -z_A\n          [ -1     0     0 ]  y_W = -x_A\n          [  0     1     0 ]  z_W = +y_A",
   "originalText": "          arkX  arkY  arkZ\nR_{W\u2190A} = [  0     0    -1 ]  x_W = -z_A\n          [ -1     0     0 ]  y_W = -x_A\n          [  0     1     0 ]  z_W = +y_A",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b1O"
