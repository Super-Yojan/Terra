   "roundness": null,
   "seed": 288924901,
   "version": 1,
   "versionNonce": 1336005664,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Check det = +1 (right-handed):\n\u2022 ARKit +Y (up)     \u2192 Terra +Z (up)\n\u2022 ARKit \u2212Z (fwd)    \u2192 Terra +X (fwd)\n\u2022 ARKit \u2212X (left)   \u2192 Terra +Y (left) \u2713",
   "originalText": "Check det = +1 (right-handed):\n\u2022 ARKit +Y (up)     \u2192 Terra +Z (up)\n\u2022 ARKit \u2212Z (fwd)    \u2192 Terra +X (fwd)\n\u2022 ARKit \u2212X (left)   \u2192 Terra +Y (left) \u2713",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
