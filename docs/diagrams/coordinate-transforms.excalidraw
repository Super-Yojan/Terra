  {
   "id": "t88",
   "type": "text",
   "x": 436,
   "y": 1270,
   "width": 300.3,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
