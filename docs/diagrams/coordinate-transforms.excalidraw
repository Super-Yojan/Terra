   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b0r"
  },
  {
   "id": "t55",
   "type": "text",
   "x": 928,
   "y": 490,
   "width": 272.25,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": "f34",
   "roundness": null,
   "seed": 1583447951,
   "version": 1,
   "versionNonce": 1596456713,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\"Walk px steps along the rover's\n forward axis x\u0302_B, then py steps\n along its left axis \u0177_B.\"\n\nSame rule in 3D: R is 3\u00d73 with\ncolumns [ x\u0302_B | \u0177_B | \u1e91_B ]!",
   "originalText": "\"Walk px steps along the rover's\n forward axis x\u0302_B, then py steps\n along its left axis \u0177_B.\"\n\nSame rule in 3D: R is 3\u00d73 with\ncolumns [ x\u0302_B | \u0177_B | \u1e91_B ]!",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b0s"
  },
  {
