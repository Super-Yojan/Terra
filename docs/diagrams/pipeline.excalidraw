  {
   "id": "t133",
   "type": "text",
   "x": 1130,
   "y": 1565,
   "width": 386.4,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
