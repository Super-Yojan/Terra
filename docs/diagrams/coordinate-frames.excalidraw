   "version": 1,
   "versionNonce": 2068124765,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Needed mapping (lens looking along rover +X):\n  body +X  =  \u2212cam Z     (lens \u2192 forward)\n  body +Y  =  \u2212cam X     (cam right \u2192 rover right)\n  body +Z  =  +cam Y     (cam up \u2192 up)\n\n  camera_to_body = [[ 0, 0,-1],\n                    [-1, 0, 0],\n                    [ 0, 1, 0]]  \u2192 roll=+90, pitch=0, yaw=\u221290",
   "originalText": "Needed mapping (lens looking along rover +X):\n  body +X  =  \u2212cam Z     (lens \u2192 forward)\n  body +Y  =  \u2212cam X     (cam right \u2192 rover right)\n  body +Z  =  +cam Y     (cam up \u2192 up)\n\n  camera_to_body = [[ 0, 0,-1],\n                    [-1, 0, 0],\n                    [ 0, 1, 0]]  \u2192 roll=+90, pitch=0, yaw=\u221290",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "index": "b13"
  },
