---
import "../styles/global.css";
import { SITE_TITLE, href, link, menu, sections } from "../consts";
import geistSansUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import iosevka400Url from "../fonts/iosevka-latin-400-normal.woff2?url";
import iosevka500Url from "../fonts/iosevka-latin-500-normal.woff2?url";

const { title, description } = Astro.props as {
    title?: string;
    description?: string;
};

const fullTitle = title && title !== SITE_TITLE ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const desc =
    description ??
    "The rover body: Rust crates, TerraPhone, and the Raspberry Pi relay.";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const routes = [
    { href: href("/"), label: "Overview" },
    ...menu.map((page) => ({ href: link(page.path), label: page.label })),
];
const isActive = (link: string) => (link.replace(/\/$/, "") || "/") === path;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
        <link rel="sitemap" href={href("/sitemap-index.xml")} />
        <!-- Same files the @font-face rules use. crossorigin is required
             or the browser downloads the face twice. -->
        <link rel="preload" href={geistSansUrl} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={iosevka400Url} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={iosevka500Url} as="font" type="font/woff2" crossorigin />
        <title>{fullTitle}</title>
        <meta name="description" content={desc} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={desc} />
        <meta property="og:type" content="website" />
        <script is:inline>
            // Reveals hide themselves only when JS can bring them back.
            document.documentElement.classList.add("js");
        </script>
    </head>
    <body>
        <div class="cursor" id="cursor" aria-hidden="true"></div>
        <svg class="grain" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <filter id="film-grain">
                <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
                <feColorMatrix type="saturate" values="0" />
            </filter>
            <rect width="100%" height="100%" filter="url(#film-grain)" />
        </svg>

        <a href="#main" class="skip-link">Skip to content</a>

        <!-- The bar itself is inert so the hero stays clickable underneath;
             only the controls take the pointer back. -->
        <header class="nav">
            <div class="nav-group">
                <a href={href("/")} class="brand" aria-label="Terra — overview">
                    <span class="brand-name">Terra</span>
                </a>

                <button
                    type="button"
                    class="pill pill-dark nav-toggle"
                    id="nav-toggle"
                    aria-expanded="false"
                    aria-controls="menu"
                >
                    <span class="knob knob-light" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="12"
                            height="12"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                        >
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                    </span>
                    <span class="pill-text">Menu</span>
                </button>

                <div class="pill pill-soft nav-tags">
                    <span>Rover</span>
                    <span>iPhone + Pi</span>
                </div>
            </div>

            <div class="nav-group">
                <div class="pill pill-soft nav-status">
                    <a
                        class="knob knob-dark"
                        href="https://github.com/Super-Yojan/Terra/releases"
                        aria-label="Download Terra"
                    >
                        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                            <circle cx="8" cy="8" r="2.1" />
                            <circle cx="16" cy="8" r="2.1" />
                            <circle cx="8" cy="16" r="2.1" />
                            <circle cx="16" cy="16" r="2.1" />
                        </svg>
                    </a>
                    <span class="nav-status-label">Releases</span>
                </div>
            </div>
        </header>

        <nav class="menu on-pitch" id="menu" aria-label="Main">
            {
                routes.map((r) => (
                    <a
                        href={r.href}
                        class="menu-link"
                        aria-current={isActive(r.href) ? "page" : undefined}
                    >
                        {r.label}
                    </a>
                ))
            }
            <div class="menu-meta t-label">
                <a href="https://github.com/Super-Yojan/Terra" target="_blank" rel="noopener">GitHub</a>
                <a href={href("/api/")}>Rust API</a>
                <a href="https://super-yojan.dev/ARGOS/">ARGOS</a>
                <a href="https://super-yojan.dev/Zorvane/">Zorvane</a>
                <a href="https://super-yojan.dev/">super-yojan.dev</a>
            </div>
        </nav>

        <main id="main">
            <slot />
        </main>

        <footer class="foot on-pitch">
            <div class="shell">
                <div class="foot-grid">
                    <div>
                        <p class="foot-brand">Ter<br />ra</p>
                        <p class="foot-bio">
                            The rover body. An iPhone gathers the sensors, Rust
                            runs control, and a Raspberry Pi relays drive
                            commands to the motors.
                        </p>
                    </div>

                    <div>
                        <h2 class="t-label">Guides</h2>
                        <div class="foot-list">
                            {sections.filter((s) => s.path).map((s) => <a href={link(s.path!)}>{s.title}</a>)}
                            <a href={link("/hardware/FLASH_SD")}>Flash the SD card</a>
                            <a href={link("/getting-started")}>Getting started</a>
                        </div>
                    </div>

                    <div>
                        <h2 class="t-label">Fleet</h2>
                        <div class="foot-list">
                            <a href="https://github.com/Super-Yojan/Terra" target="_blank" rel="noopener">GitHub</a>
                            <a href="https://super-yojan.dev/ARGOS/">ARGOS</a>
                            <a href="https://super-yojan.dev/Zorvane/">Zorvane</a>
                            <a href="https://super-yojan.dev/docs">All docs</a>
                        </div>
                    </div>
                </div>

                <div class="foot-bar">
                    <span>© {year} Yojan Gautam</span>
                    <span>Built with Astro · Washington, DC</span>
                </div>
            </div>
        </footer>

        <script>
            // ---- diagrams ---------------------------------------------
            // Mermaid fences are drawn in the browser, as MkDocs did. The
            // library is only fetched by pages that have one.
            if (document.querySelector("pre.mermaid")) {
                import("mermaid").then(async ({ default: mermaid }) => {
                    mermaid.initialize({ startOnLoad: false, theme: "neutral", fontFamily: "inherit" });
                    await mermaid.run({ querySelector: "pre.mermaid" });
                });
            }

            // ---- difference cursor -------------------------------------
            const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
            const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
            const cursor = document.getElementById("cursor");

            if (cursor && fine.matches) {
                let tx = window.innerWidth / 2;
                let ty = window.innerHeight / 2;
                let cx = tx;
                let cy = ty;
                let awake = false;

                window.addEventListener(
                    "pointermove",
                    (e) => {
                        tx = e.clientX;
                        ty = e.clientY;
                        if (!awake) {
                            awake = true;
                            cx = tx;
                            cy = ty;
                            cursor.classList.add("is-awake");
                        }
                    },
                    { passive: true },
                );

                document.addEventListener("pointerover", (e) => {
                    const el = e.target as Element | null;
                    cursor.classList.toggle(
                        "is-grown",
                        !!el?.closest?.('a, button, [role="button"], [data-cursor="grow"]'),
                    );
                });

                // Hide on the way out and forget the position, so the next
                // move shows the cursor again and snaps it to the pointer
                // instead of gliding in from where it left.
                const sleep = () => {
                    awake = false;
                    cursor.classList.remove("is-awake");
                };
                // pointerleave does not bubble, so this must sit on the root
                // element — on `document` it would never fire.
                document.documentElement.addEventListener("pointerleave", sleep);
                // A fast exit through the window edge can skip pointerleave;
                // mouseout with no next element is the pointer leaving the page.
                document.addEventListener("mouseout", (e) => {
                    if (!e.relatedTarget) sleep();
                });
                window.addEventListener("blur", sleep);

                // Lerp toward the pointer for the lagging feel; snap when the
                // visitor asked for reduced motion.
                const frame = () => {
                    const k = calm.matches ? 1 : 0.18;
                    cx += (tx - cx) * k;
                    cy += (ty - cy) * k;
                    cursor.style.translate = `${cx}px ${cy}px`;
                    requestAnimationFrame(frame);
                };
                requestAnimationFrame(frame);
            }

            // ---- the bar against pitch ----------------------------------
            // Two grounds can end up behind the fixed bar: the open menu, and
            // the footer sliding under it on a short viewport. Both would
            // swallow the ink wordmark and the ink pill, so the bar is told
            // when it is standing on pitch and flips its whole control set.
            const nav = document.querySelector(".nav");
            const pitch = document.querySelector(".foot");
            const panel = document.getElementById("menu");

            const syncNav = () => {
                if (!nav) return;
                // The bar's own band, not the whole viewport: the two only
                // clash where they actually overlap.
                const band = nav.getBoundingClientRect().bottom;
                const onPitch =
                    panel?.classList.contains("is-open") ||
                    (!!pitch && pitch.getBoundingClientRect().top < band);
                nav.classList.toggle("is-inverse", !!onPitch);
            };

            window.addEventListener("scroll", syncNav, { passive: true });
            window.addEventListener("resize", syncNav, { passive: true });
            syncNav();

            // ---- menu ---------------------------------------------------
            const toggle = document.getElementById("nav-toggle");
            const menu = document.getElementById("menu");

            if (toggle && menu) {
                const setOpen = (open: boolean) => {
                    menu.classList.toggle("is-open", open);
                    toggle.classList.toggle("is-open", open);
                    toggle.setAttribute("aria-expanded", String(open));
                    document.body.style.overflow = open ? "hidden" : "";
                    syncNav();
                };

                toggle.addEventListener("click", () =>
                    setOpen(!menu.classList.contains("is-open")),
                );
                document.addEventListener("keydown", (e) => {
                    if (e.key === "Escape" && menu.classList.contains("is-open")) {
                        setOpen(false);
                        toggle.focus();
                    }
                });
                menu.querySelectorAll("a").forEach((a) =>
                    a.addEventListener("click", () => setOpen(false)),
                );
            }

            // ---- code blocks --------------------------------------------
            // Every listing, including Markdown, gets one copy control.
            // The button sits outside the pre so its label is never copied.
            const writeClipboard = async (text: string): Promise<boolean> => {
                try {
                    if (navigator.clipboard?.writeText) {
                        await navigator.clipboard.writeText(text);
                        return true;
                    }
                } catch {
                    /* Permission or a non-secure context: try the fallback. */
                }
                try {
                    const area = document.createElement("textarea");
                    area.value = text;
                    area.setAttribute("readonly", "");
                    area.style.position = "fixed";
                    area.style.top = "0";
                    area.style.left = "0";
                    area.style.opacity = "0";
                    document.body.append(area);
                    area.focus();
                    area.select();
                    const ok = document.execCommand("copy");
                    area.remove();
                    return ok;
                } catch {
                    return false;
                }
            };

            const codeText = (pre: HTMLElement): string => {
                const source = pre.querySelector("code") ?? pre;
                const clone = source.cloneNode(true) as HTMLElement;
                clone
                    .querySelectorAll(".line-number, [data-line-number]")
                    .forEach((node) => node.remove());
                let text = clone.innerText.replace(/\u00a0/g, " ").replace(/\n$/, "");
                const lines = text.split("\n");
                const filled = lines.filter((line) => line.length > 0);
                if (filled.length > 0 && filled.every((line) => line.startsWith("$ "))) {
                    text = lines.map((line) => line.replace(/^\$ /, "")).join("\n");
                }
                return text;
            };

            document.querySelectorAll("pre").forEach((node) => {
                const pre = node as HTMLElement;
                if (pre.closest(".code-block, .katex, .diagram")) return;
                const wrap = document.createElement("div");
                wrap.className = "code-block";
                pre.before(wrap);
                wrap.append(pre);
                if (!pre.hasAttribute("tabindex")) pre.tabIndex = 0;

                const button = document.createElement("button");
                button.type = "button";
                button.className = "code-copy";
                button.textContent = "Copy";
                button.setAttribute("aria-label", "Copy code");
                button.setAttribute("aria-live", "polite");
                wrap.insertBefore(button, pre);

                let timer = 0;
                button.addEventListener("click", async () => {
                    const ok = await writeClipboard(codeText(pre));
                    if (!ok) return;
                    button.textContent = "Copied";
                    button.setAttribute("aria-label", "Copied");
                    window.clearTimeout(timer);
                    timer = window.setTimeout(() => {
                        button.textContent = "Copy";
                        button.setAttribute("aria-label", "Copy code");
                    }, 1600);
                });
            });

            // ---- reveals ------------------------------------------------
            const targets = document.querySelectorAll(".reveal-line, .rise");

            if (targets.length) {
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            const el = entry.target as HTMLElement;

                            // Anything already above the viewport must be shown
                            // outright, with no entrance. Otherwise an anchor
                            // jump (/projects#glid), a restored scroll position,
                            // or find-in-page leaves that content invisible
                            // forever, because it was never observed entering.
                            const passed = entry.boundingClientRect.bottom < 0;

                            if (!entry.isIntersecting && !passed) return;

                            const delay = passed
                                ? 0
                                : Number(el.dataset.delay ?? 0);
                            window.setTimeout(() => el.classList.add("is-in"), delay);
                            io.unobserve(el);
                        });
                    },
                    { rootMargin: "0px 0px -10% 0px" },
                );
                targets.forEach((t) => io.observe(t));
            }
        </script>
    </body>
</html>
