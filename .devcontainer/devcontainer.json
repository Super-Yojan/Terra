{
  "name": "Terra simulator",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "minimal",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode"
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [6080, 5901, 7447],
  "portsAttributes": {
    "6080": {
      "label": "noVNC desktop",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5901": {
      "label": "VNC desktop",
      "onAutoForward": "silent"
    },
    "7447": {
      "label": "Zenoh peer",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "CARGO_TARGET_DIR": "/var/cache/terra-target",
    "CARGO_PROFILE_DEV_DEBUG": "line-tables-only",
    "RUSTFLAGS": "-C link-arg=-fuse-ld=lld",
    "DISPLAY": ":1",
    "WGPU_BACKEND": "vulkan",
    "WGPU_POWER_PREFERENCE": "low_power",
    "VK_ICD_FILENAMES": "/etc/vulkan/terra-lvp.json",
    "VK_DRIVER_FILES": "/etc/vulkan/terra-lvp.json",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "GALLIUM_DRIVER": "llvmpipe"
  },
  "mounts": [
    "source=terra-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=terra-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=terra-cargo-target,target=/var/cache/terra-target,type=volume"
  ],
  "runArgs": ["--shm-size=2g", "--init"],
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "ms-python.python",
        "GitHub.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/terra-venv/bin/python",
        "python.analysis.extraPaths": ["simulator/tools"],
        "files.watcherExclude": {
          "/var/cache/terra-target/**": true,
          "**/target/**": true
        },
        "search.exclude": {
          "/var/cache/terra-target": true,
          "**/target": true
        }
      }
    },
    "codespaces": {
      "openFiles": ["docs/DEVELOP-WITHOUT-MAC.md"]
    }
  }
}
